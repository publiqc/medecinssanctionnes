---
import { statusOf, formatDate, type Doctor, type Lang } from "../lib/types";

interface Props {
  doctor: Doctor;
  lang?: Lang;
}
const { doctor, lang = "fr" } = Astro.props;
const status = statusOf(doctor, lang);
const sinceWord = lang === "en" ? "since" : "depuis le";
const sinceMatch = /(\d{4}-\d{2}-\d{2})/.exec(doctor.statusText);
// Only the active-sanction statuses carry a meaningful "since" date in statusText;
// for a served or historical record that date would be unrelated (e.g. resignation).
const showSince = status.kind === "radiated" || status.kind === "restricted";
const since = showSince && sinceMatch ? `${sinceWord} ${formatDate(sinceMatch[1], lang)}` : "";

const alertClass = {
  error: "alert-error",
  warning: "alert-warning",
  neutral: "bg-base-100 border border-base-300",
  success: "alert-success",
}[status.tone];

const icons = {
  error: '<path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><path d="M12 9v4"/><path d="M12 17h.01"/>',
  warning: '<path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><path d="M12 9v4"/><path d="M12 17h.01"/>',
  neutral: '<circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/>',
  success: '<circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/>',
}[status.tone];
---

<div class:list={["alert", alertClass, "shadow-sm"]} role="status">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="w-6 h-6 shrink-0" set:html={icons}></svg>
  <p class="text-lg">
    <span class="font-semibold">{status.label}</span>
    {since && <span class="font-semibold">{" "}{since}</span>}
  </p>
</div>
