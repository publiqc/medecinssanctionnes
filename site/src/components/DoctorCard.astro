---
import { fullName, cardDisplay, specialtyOf, type Doctor, type Lang } from "../lib/types";
import { doctorHref } from "../i18n/ui";

interface Props {
  doctor: Doctor;
  lang: Lang;
}
const { doctor, lang } = Astro.props;
const d = doctor;
const disp = cardDisplay(d, lang);
const specialty = specialtyOf(d, lang);
const badgeClass = {
  error: "badge-error",
  warning: "badge-warning",
  neutral: "badge-ghost",
  success: "badge-success",
}[disp.tone];
---

<li class="doctor-card min-w-0">
  <a
    href={doctorHref(lang, d.slug)}
    class="card card-compact bg-base-100 border border-base-300 hover:border-primary hover:shadow-md transition-all shadow-sm min-w-0"
  >
    <div class="card-body flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between sm:gap-4">
      <div class="min-w-0">
        <div class="text-lg font-semibold flex items-baseline gap-2 min-w-0">
          <span class="truncate">{fullName(d)}</span>
          <span class="text-sm font-normal opacity-70 shrink-0">{d.number}</span>
        </div>
        {specialty && (
          <div class="text-sm opacity-70 flex items-center gap-1.5 min-w-0">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="w-4 h-4 shrink-0 opacity-70">
              <path d="M6 4h-1a2 2 0 0 0-2 2v3.5a5.5 5.5 0 0 0 11 0V6a2 2 0 0 0-2-2h-1" />
              <path d="M8 15a6 6 0 1 0 12 0v-3" />
              <path d="M11 3v2" />
              <path d="M6 3v2" />
              <circle cx="20" cy="10" r="2" />
            </svg>
            <span class="truncate">{specialty}</span>
          </div>
        )}
        {d.city && (
          <div class="text-sm opacity-70 flex items-center gap-1.5 min-w-0">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="w-4 h-4 shrink-0 opacity-70">
              <path d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
              <path d="M19.5 10.5c0 7.5-7.5 12-7.5 12s-7.5-4.5-7.5-12a7.5 7.5 0 1115 0z" />
            </svg>
            <span class="truncate">{d.city}</span>
          </div>
        )}
      </div>
      <div class="flex flex-wrap items-center gap-x-2 gap-y-1 shrink-0 sm:block sm:text-right sm:max-w-[45%]">
        <span class:list={["badge badge-lg font-medium", badgeClass]}>
          {disp.label}
        </span>
        {disp.countLabel && (
          <span class:list={["badge badge-sm font-medium sm:mt-1 sm:block sm:w-fit sm:ml-auto", badgeClass]}>{disp.countLabel}</span>
        )}
        {disp.detail && (
          <span class="text-xs opacity-70 sm:block sm:mt-1">{disp.detail}</span>
        )}
      </div>
    </div>
  </a>
</li>
