---
import Layout from "../layouts/Layout.astro";
import StatusBanner from "./StatusBanner.astro";
import SanctionBadge from "./SanctionBadge.astro";
import { fullName, specialtyOf, formatDate, formatDuration, sanctionTone, resultLabel, localizePhrase, type Doctor, type Lang } from "../lib/types";
import { useTranslations, basePath, doctorHref, otherLang } from "../i18n/ui";

interface Props {
  doctor: Doctor;
  lang: Lang;
}
const { doctor, lang } = Astro.props;
const t = useTranslations(lang);

const TONE_BADGE = {
  error: "badge-error",
  warning: "badge-warning",
  neutral: "badge-neutral",
  success: "badge-success",
} as const;

const sanctions = [...doctor.sanctions].sort((a, b) => b.date.localeCompare(a.date));
const bottinUrl = `https://www.cmq.org/fr/bottin/medecins?number=${doctor.number}`;
const specialty = specialtyOf(doctor, lang);
// Years the search should match: the years of this doctor's disciplinary events.
const searchYears = [
  ...new Set(
    [
      ...(doctor.sanctionYears ?? []),
      ...(doctor.decisions ?? []).map((d) => Number((d.date ?? "").slice(0, 4))),
      ...(doctor.notices ?? []).map((n) => Number((n.date ?? "").slice(0, 4))),
    ].filter((y) => y > 1900),
  ),
]
  .sort()
  .join(" ");
// The text Pagefind indexes for this doctor. Single-letter tokens (middle
// initials like "C.") are dropped: the search engine treats them as words and
// fuzzy-matches any query sharing that letter, which surprises users. The full
// name is still shown on the page and on result cards.
const dropInitials = (s: string) =>
  s.split(/\s+/).filter((tok) => tok.replace(/[.,]/g, "").length > 1).join(" ");
const searchName = dropInitials(fullName(doctor));
const searchExtra = [doctor.number, specialty, searchYears].filter(Boolean).join(" ");
const home = basePath[lang] || "/";
const altHref = doctorHref(otherLang[lang], doctor.slug);
const title = `${fullName(doctor)} · ${t("site.brand")}`;
const description = `${t("detail.metaDescription")} ${fullName(doctor)} (${doctor.number}).`;
---

<Layout title={title} description={description} lang={lang} altHref={altHref}>
  <a href={home} class="group inline-flex items-center gap-1.5 text-sm font-medium text-base-content/70 transition-colors hover:text-base-content">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="w-4 h-4 transition-transform group-hover:-translate-x-0.5">
      <path d="M19 12H5" />
      <path d="M12 19l-7-7 7-7" />
    </svg>
    {t("nav.back")}
  </a>

  {/* Search index: ONLY name, permit, specialty and year are searchable. An
     explicit title (initials removed) overrides Pagefind's default, which would
     otherwise index the visible H1 and match single-letter initials. */}
  <div class="hidden" aria-hidden="true" data-pagefind-body>
    <span data-pagefind-meta="title">{searchName}</span> {searchExtra}
  </div>

  <div class="mt-3 mb-5">
    <h1 class="text-3xl font-bold tracking-tight">
      <span>{fullName(doctor)}</span>{" "}
      <span class="text-lg font-normal opacity-70">{doctor.number}</span>
    </h1>    {doctor.deceased && (
      <p class="mt-1 text-sm opacity-60">{t("detail.deceased")}</p>
    )}    <div class="mt-3 space-y-1.5 text-base opacity-80">
      {specialty && (
        <div class="flex items-center gap-2">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="w-4 h-4 shrink-0 opacity-70">
            <path d="M6 4h-1a2 2 0 0 0-2 2v3.5a5.5 5.5 0 0 0 11 0V6a2 2 0 0 0-2-2h-1" />
            <path d="M8 15a6 6 0 1 0 12 0v-3" />
            <path d="M11 3v2" />
            <path d="M6 3v2" />
            <circle cx="20" cy="10" r="2" />
          </svg>
          <span>{specialty}</span>
        </div>
      )}
      {doctor.city && (
        <div class="flex items-center gap-2">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="w-4 h-4 shrink-0 opacity-70">
            <path d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
            <path d="M19.5 10.5c0 7.5-7.5 12-7.5 12s-7.5-4.5-7.5-12a7.5 7.5 0 1115 0z" />
          </svg>
          <span>{doctor.city}</span>
        </div>
      )}
      {doctor.memberSince && (
        <div class="flex items-center gap-2">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="w-4 h-4 shrink-0 opacity-70">
            <rect width="18" height="18" x="3" y="4" rx="2" />
            <path d="M3 10h18" />
            <path d="M8 2v4" />
            <path d="M16 2v4" />
          </svg>
          <span>{t("detail.memberSince")} {doctor.memberSince}</span>
          {doctor.specialtyYear && (
            <>
              <span class="w-px h-[0.8em] bg-current opacity-30 shrink-0"></span>
              <span>{t("detail.specialistSince")} {doctor.specialtyYear}</span>
            </>
          )}
        </div>
      )}
    </div>
  </div>

  <div><StatusBanner doctor={doctor} lang={lang} /></div>

  {doctor.formerlyStruckOff && (
    <p class="mt-2 flex items-center gap-1.5 text-sm font-medium opacity-80">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="w-4 h-4 shrink-0">
        <path d="M3 3v5h5" />
        <path d="M3.05 13A9 9 0 1 0 6 5.3L3 8" />
        <path d="M12 7v5l4 2" />
      </svg>
      <span>{t("status.formerlyStruckOff")}</span>
    </p>
  )}

  {sanctions.length === 0 && doctor.notices && doctor.notices.length > 0 && (
    <section class="mt-8" data-pagefind-weight="0.4">
      <h2 class="text-xl font-semibold mb-4">{t("detail.notices")}</h2>
      <ul class="space-y-2">
        {doctor.notices.map((n) => (
          <li class="flex flex-wrap items-center gap-2">
            <SanctionBadge type={n.type} active={true} lang={lang} />
            <span class="text-sm opacity-70">{t("detail.noticePublished")} {formatDate(n.date, lang)}</span>
          </li>
        ))}
      </ul>
      <p class="text-xs opacity-60 mt-2">{t("detail.noticeSource")}</p>
    </section>
  )}

  {sanctions.length > 0 && (
  <section class="mt-8" data-pagefind-weight="0.4">
    <h2 class="text-xl font-semibold mb-4">{t("detail.history")}</h2>
    <ul class="timeline timeline-vertical timeline-compact">
      {sanctions.map((s, i) => (
        <li>
          {i > 0 && <hr />}
          <div class="timeline-middle">
            <span
              class:list={[
                "badge badge-xs",
                s.active ? TONE_BADGE[sanctionTone(s.type)] : "badge-ghost",
              ]}
            ></span>
          </div>
          <div class="timeline-end timeline-box w-full mb-6 bg-base-100">
            <div class="flex flex-wrap items-center gap-2 mb-2">
              <SanctionBadge type={s.type} active={s.active} lang={lang} />
              {s.active
                ? <span class:list={["badge badge-lg font-semibold", TONE_BADGE[sanctionTone(s.type)]]}>{t("detail.inEffect")}</span>
                : <span class="badge badge-ghost badge-lg font-semibold">{t("detail.served")}</span>}
            </div>
            <div class="text-sm opacity-70 mb-3 space-y-0.5">
              {s.durationText && <div>{t("detail.duration")} {formatDuration(s.durationText, lang)}</div>}
              <div>{t("detail.start")} {formatDate(s.date, lang)}</div>
              {s.endDate && (
                <div>{t("detail.end")} {formatDate(s.endDate, lang)}{s.endDerived ? ` ${t("detail.estimated")}` : ""}</div>
              )}
            </div>
            {s.reason && (
              <div>
                {t("detail.noticeLabel") && (
                  <div class="text-xs opacity-60 mb-1">{t("detail.noticeLabel")}</div>
                )}
                <blockquote class="notice-prose prose prose-sm max-w-none border-l-4 border-base-300 pl-4 italic opacity-90">
                  {s.reason}
                </blockquote>
              </div>
            )}
          </div>
        </li>
      ))}
    </ul>
  </section>
  )}

  {doctor.decisions && doctor.decisions.length > 0 && (
    <section class="mt-8" data-pagefind-weight="0.4">
      <h2 class="text-xl font-semibold mb-4">{t("decision.heading")}</h2>
      <ul class="space-y-4">
        {doctor.decisions.map((d) => (
          <li class="rounded-box border border-base-300 bg-base-100 p-4">
            <div class="flex flex-wrap items-baseline gap-x-2 gap-y-1 text-sm">
              <span class="font-medium">{t("decision.fileLabel")} {d.case}</span>
              {d.date && (
                <>
                  <span class="w-px h-[0.8em] bg-current opacity-30 shrink-0"></span>
                  <span class="opacity-70">{formatDate(d.date, lang)}</span>
                </>
              )}
              {d.result && <span class="badge badge-ghost badge-sm">{resultLabel(d.result, lang)}</span>}
            </div>

            {d.precision && <p class="mt-0.5 text-xs opacity-60">{localizePhrase(d.precision, lang)}</p>}

            {d.grounds && (
              <p class="mt-2 text-sm">
                <span class="opacity-60">{t("decision.grounds")} : </span>{d.grounds}
              </p>
            )}

            {d.disposition && (
              <p class="mt-2 text-sm">
                <span class="opacity-60">{t("decision.disposition")} : </span>{d.disposition}
              </p>
            )}

            {d.precisionStatus && (
              <p class="mt-1 text-xs italic opacity-70">{localizePhrase(d.precisionStatus, lang)}</p>
            )}

            {d.publicationBan && (
              <p class="mt-2 flex items-start gap-1.5 text-xs opacity-70">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="w-4 h-4 shrink-0 mt-px">
                  <rect width="18" height="11" x="3" y="11" rx="2" />
                  <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                </svg>
                <span>{t("decision.ban")}</span>
              </p>
            )}

            {d.charges && (
              <details class="group mt-3">
                <summary class="flex cursor-pointer list-none items-center gap-1 text-sm font-medium text-primary hover:underline">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="w-4 h-4 transition-transform group-open:rotate-90">
                    <path d="M9 18l6-6-6-6" />
                  </svg>
                  {t("decision.showCharges")}
                </summary>
                <div class="mt-2">
                  <div class="text-xs opacity-60 mb-1">{t("decision.chargesLabel")}</div>
                  <blockquote class="notice-prose prose prose-sm max-w-none border-l-4 border-base-300 pl-4 italic opacity-90">
                    {d.charges}
                  </blockquote>
                  <p class="text-xs opacity-60 mt-2">{t("decision.chargesNote")}</p>
                </div>
              </details>
            )}

            {d.links && d.links.length > 0 && (
              <div class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-sm">
                {d.links.map((url) => (
                  <a class="link" href={url} rel="nofollow">{t("decision.viewDecision")}</a>
                ))}
              </div>
            )}
          </li>
        ))}
      </ul>
    </section>
  )}

  <section class="mt-8 space-y-2 text-sm" data-pagefind-ignore>
    <h2 class="text-lg font-semibold">{t("detail.sources")}</h2>
    <ul class="list-disc pl-5 space-y-1">
      <li>
        <a class="link" href={bottinUrl} rel="nofollow">
          {t("detail.officialRecord")}
        </a>
      </li>
      {doctor.rulingLinks.map((r) => (
        <li>
          <a class="link" href={r.url} rel="nofollow">
            {t("detail.decision")} {r.case} ({r.source}){r.date ? (lang === "en" ? ` (${r.date})` : ` (le ${r.date})`) : ""}
          </a>
        </li>
      ))}
    </ul>
    <p class="opacity-70 pt-2">
      {t("detail.sourceNote")}
    </p>
  </section>
</Layout>
